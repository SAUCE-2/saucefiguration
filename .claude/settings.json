{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash zsh/install.test.sh)",
      "Bash(bash zsh/check-update.test.sh)",
      "Bash(bash zsh/install.sh --dry-run)",
      "Bash(shellcheck:*)",
      "Bash(zsh -n:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(bash zsh/install.sh)",
      "Bash(./zsh/install.sh)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(~/.ssh/id_*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/**)",
      "Edit(~/.oh-my-zsh/**)"
    ]
  }
}
