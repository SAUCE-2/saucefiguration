# Per-machine hosts (names, users, addresses) live in ~/.ssh/config.d/,
# which is never committed: this repo is public.
Include config.d/*

Host *
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
  IgnoreUnknown UseKeychain
  UseKeychain yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  SetEnv TERM=xterm-256color
