{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "patch_pwsh_bleed": true,
  "async": false,
  "upgrade": {
    "auto": false,
    "notice": false,
    "interval": "168h",
    "source": "github"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:fg",
          "template": "{{ .Icon }} "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:purple",
          "template": "{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": "➜ ",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:cyan",
          "template": "{{ .Path }}",
          "options": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:blue",
          "template": " git:(<p:red>{{ .Ref }}</>){{ if or .Working.Changed .Staging.Changed }} <p:yellow>✗</>{{ end }}",
          "options": {
            "fetch_status": true
          }
        }
      ]
    }
  ],
  "palette": {
    "green": "#9ece6a",
    "red": "#f7768e",
    "cyan": "#7dcfff",
    "blue": "#7aa2f7",
    "yellow": "#e0af68",
    "purple": "#bb9af7",
    "fg": "#c0caf5"
  }
}
