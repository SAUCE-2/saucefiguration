{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "patch_pwsh_bleed": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:muted-foreground",
          "template": "{{ .Icon }} "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:secondary",
          "template": "{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:primary",
          "template": "{{ .Path }} ",
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:git",
          "template": "{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if or .Working.Changed .Staging.Changed }} <p:destructive>\u2717</>{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:closer",
          "template": "\uf105"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:muted-foreground",
          "template": " \uf252 {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:muted-foreground",
          "template": " \uf017 {{ .CurrentDate | date .Format }} "
        }
      ]
    }
  ],
  "palette": {
    "primary": "#6633ff",
    "secondary": "#0091c8",
    "git": "#9678f0",
    "destructive": "#fa788c",
    "muted-foreground": "#69697d",
    "closer": "#85859f"
  }
}
